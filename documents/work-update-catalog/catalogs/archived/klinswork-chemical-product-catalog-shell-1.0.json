  },
  "catalog_policy": {
    "entry_unit": "One exact commercial product form or formulation, in one jurisdiction and language.",
    "authority_model": {
      "inventory_sheet": "Research lead and workplace-context source only.",
      "manufacturer_product_record": "Primary authority for commercial product identity.",
      "official_sds_record": "Primary authority for product safety information."
    },
    "inventory_identifier_policy": "Product codes, model numbers, manufacturer numbers, and similar identifiers from the inventory sheet are unverified until confirmed by an official manufacturer record.",
    "formulation_policy": "Concentrate, manufacturer-defined diluted use solution, and ready-to-use forms are separate entries whenever the official product or SDS records distinguish them.",
    "append_policy": "Only append an entry to entries after product identity, manufacturer record, SDS match, and required section coverage have been reviewed."
  },
